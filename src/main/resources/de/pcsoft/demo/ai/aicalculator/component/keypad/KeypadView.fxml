<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>

<fx:root type="javafx.scene.layout.GridPane"
         styleClass="keypad"
         xmlns="http://javafx.com/javafx"
         xmlns:fx="http://javafx.com/fxml">
    <columnConstraints>
        <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0"/>
        <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0"/>
        <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0"/>
        <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0"/>
    </columnConstraints>
    <rowConstraints>
        <RowConstraints vgrow="ALWAYS" percentHeight="20.0"/>
        <RowConstraints vgrow="ALWAYS" percentHeight="20.0"/>
        <RowConstraints vgrow="ALWAYS" percentHeight="20.0"/>
        <RowConstraints vgrow="ALWAYS" percentHeight="20.0"/>
        <RowConstraints vgrow="ALWAYS" percentHeight="20.0"/>
    </rowConstraints>

    <Button fx:id="clearButton" GridPane.columnIndex="0" GridPane.rowIndex="0"
            styleClass="keypad-key, keypad-key-clear"
            maxWidth="Infinity" maxHeight="Infinity"/>
    <Button fx:id="divideButton" GridPane.columnIndex="1" GridPane.rowIndex="0"
            styleClass="keypad-key, keypad-key-operator"
            maxWidth="Infinity" maxHeight="Infinity"/>
    <Button fx:id="multiplyButton" GridPane.columnIndex="2" GridPane.rowIndex="0"
            styleClass="keypad-key, keypad-key-operator"
            maxWidth="Infinity" maxHeight="Infinity"/>
    <Button fx:id="subtractButton" GridPane.columnIndex="3" GridPane.rowIndex="0"
            styleClass="keypad-key, keypad-key-operator"
            maxWidth="Infinity" maxHeight="Infinity"/>

    <Button fx:id="digit7Button" GridPane.columnIndex="0" GridPane.rowIndex="1"
            styleClass="keypad-key, keypad-key-digit"
            maxWidth="Infinity" maxHeight="Infinity"/>
    <Button fx:id="digit8Button" GridPane.columnIndex="1" GridPane.rowIndex="1"
            styleClass="keypad-key, keypad-key-digit"
            maxWidth="Infinity" maxHeight="Infinity"/>
    <Button fx:id="digit9Button" GridPane.columnIndex="2" GridPane.rowIndex="1"
            styleClass="keypad-key, keypad-key-digit"
            maxWidth="Infinity" maxHeight="Infinity"/>
    <Button fx:id="addButton" GridPane.columnIndex="3" GridPane.rowIndex="1" GridPane.rowSpan="2"
            styleClass="keypad-key, keypad-key-operator"
            maxWidth="Infinity" maxHeight="Infinity"/>

    <Button fx:id="digit4Button" GridPane.columnIndex="0" GridPane.rowIndex="2"
            styleClass="keypad-key, keypad-key-digit"
            maxWidth="Infinity" maxHeight="Infinity"/>
    <Button fx:id="digit5Button" GridPane.columnIndex="1" GridPane.rowIndex="2"
            styleClass="keypad-key, keypad-key-digit"
            maxWidth="Infinity" maxHeight="Infinity"/>
    <Button fx:id="digit6Button" GridPane.columnIndex="2" GridPane.rowIndex="2"
            styleClass="keypad-key, keypad-key-digit"
            maxWidth="Infinity" maxHeight="Infinity"/>

    <Button fx:id="digit1Button" GridPane.columnIndex="0" GridPane.rowIndex="3"
            styleClass="keypad-key, keypad-key-digit"
            maxWidth="Infinity" maxHeight="Infinity"/>
    <Button fx:id="digit2Button" GridPane.columnIndex="1" GridPane.rowIndex="3"
            styleClass="keypad-key, keypad-key-digit"
            maxWidth="Infinity" maxHeight="Infinity"/>
    <Button fx:id="digit3Button" GridPane.columnIndex="2" GridPane.rowIndex="3"
            styleClass="keypad-key, keypad-key-digit"
            maxWidth="Infinity" maxHeight="Infinity"/>
    <Button fx:id="equalsButton" GridPane.columnIndex="3" GridPane.rowIndex="3" GridPane.rowSpan="2"
            styleClass="keypad-key, keypad-key-equals"
            maxWidth="Infinity" maxHeight="Infinity"/>

    <Button fx:id="digit0Button" GridPane.columnIndex="0" GridPane.rowIndex="4" GridPane.columnSpan="3"
            styleClass="keypad-key, keypad-key-digit"
            maxWidth="Infinity" maxHeight="Infinity"/>
</fx:root>
